{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "pokecal-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "../public",
    "run_worker_first": ["/mcp", "/health"]
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      // OWNER ACTION REQUIRED: "1001" is the placeholder from the Cloudflare rate-limiting
      // docs, not a PokéCal-specific value. namespace_id must be a positive integer that is
      // unique among the rate-limit namespaces in YOUR Cloudflare account; reusing an id
      // shares the counter with any other Worker using it. Pick your own id before deploying.
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
